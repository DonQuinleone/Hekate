# Hekate configuration. Copy to .env and adjust.

# Public hostname Caddy serves Hekate on (used by deploy/compose.yml).
HEKATE_DOMAIN=localhost

# PostgreSQL. The compose file builds this from POSTGRES_PASSWORD; set it directly for development.
DATABASE_URL=postgres://hekate:hekate@localhost:5432/hekate
POSTGRES_PASSWORD=change-me

# API server
PORT=3000
# Apply database migrations when the server starts.
MIGRATE_ON_START=false
# Public URL Hekate is reached at (the Caddy address in production).
PUBLIC_URL=http://localhost:3000
# Secret for signing sessions: at least 32 random characters, for example `openssl rand -base64 48`.
AUTH_SECRET=change-me-to-at-least-32-random-characters
# Extra origins allowed to call the API with credentials; the Vite dev server in development.
TRUSTED_ORIGINS=http://localhost:5173
# Directory with the built web app; the app image sets this.
# WEB_DIST=/app/apps/web/dist

# Storage. Name one or more backends; each new object goes to the organisation's
# chosen backend, or to STORAGE_DEFAULT (the first listed when unset).
STORAGE_BACKENDS=local
# STORAGE_DEFAULT=local
# Local disk (the app image stores under /data/storage).
STORAGE_LOCAL_PATH=data/storage
# An S3-compatible backend named "archive" (AWS S3, Garage, SeaweedFS, R2, B2, Wasabi and so on):
# STORAGE_BACKENDS=local,archive
# STORAGE_ARCHIVE_DRIVER=s3
# STORAGE_ARCHIVE_BUCKET=hekate-media
# STORAGE_ARCHIVE_REGION=eu-west-2
# STORAGE_ARCHIVE_ENDPOINT=https://s3.example.com    # omit for AWS
# STORAGE_ARCHIVE_FORCE_PATH_STYLE=true              # most self-hosted services
# STORAGE_ARCHIVE_PREFIX=hekate                      # share a bucket safely
# STORAGE_ARCHIVE_ACCESS_KEY_ID=...                  # omit both to use the AWS credential chain
# STORAGE_ARCHIVE_SECRET_ACCESS_KEY=...              # or STORAGE_ARCHIVE_SECRET_ACCESS_KEY_FILE=/run/secrets/...
