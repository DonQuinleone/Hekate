{
  "name": "@hekate/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "config:reference": "node scripts/config-reference.ts",
    "cli": "node src/cli.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@better-auth/sso": "1.7.10",
    "@hekate/db": "workspace:*",
    "@hekate/shared": "workspace:*",
    "@hekate/storage": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "kysely": "0.29.7",
    "ldapts": "9.2.0",
    "nodemailer": "^10.1.7",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.7"
