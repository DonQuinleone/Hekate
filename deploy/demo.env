# The demo's settings (deploy/compose.demo.yml): published values, for one laptop only, so the
# demo comes up with no .env to write. They protect nothing: HEKATE_DEMO makes the server refuse
# any address but localhost, so they can never run a real instance. A real one gets its own
# from the installer, or from .env.example.
HEKATE_DOMAIN=localhost
POSTGRES_PASSWORD=hekate-demo
# 32 bytes, base64: the key that wraps every workspace key of the demo.
MASTER_KEY=aGVrYXRlLWRlbW8tbWFzdGVyLWtleS1vbi1sYXB0b3A=
AUTH_SECRET=hekate-demo-auth-secret-for-one-laptop-only-never-a-real-address
